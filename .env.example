# Both applications run with none of these set. Copy to .env and export the
# ones you need, e.g.  set -a; source .env; set +a

# ---------------------------------------------------------------- SUFRA OS
# Seed synthetic demo data when no database exists yet
NOVA_SEED_DEMO=1
# NOVA_DB_PATH=./sufra-os/nova.db
# DATABASE_URL=postgresql+psycopg://user:password@host/sufra
# SUFRA_TZ=Asia/Baku

# Where SUFRA 360 is, and where its venue files are
# SUFRA_360_ORIGIN=http://127.0.0.1:8013
# SUFRA_360_VENUE=./sufra-360/venue

# Base URL written into QR links (set this on a hosted deployment)
# SUFRA_PUBLIC_URL=
# SUFRA_STAFF_URL=
# Fernet key for staff badges; generated into sufra-os/.staff-qr.key if unset
# SUFRA_STAFF_QR_KEY=

# Demo switches
# NOVA_SIMULATE=0
# NOVA_ALLOW_DEMO_RESET=0

# Optional integrations
# BI_API_KEY=
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# --------------------------------------------------------------- SUFRA 360
# SUFRA_OS_BASE=http://127.0.0.1:8123
# SUFRA_OS_TIMEOUT=12
# PORT=8013
